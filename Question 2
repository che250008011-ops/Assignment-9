#include<iostream>
using namespace std;
struct color{
    int red;
    int green;
    int blue;
};
int main(){
    color colors[5];
        colors[0]={100,150,200};
        colors[1]={50,120,180};
        colors[2]={255,100,0};
        colors[3]={30,60,90};
        colors[4]={0,255,128};
for(int i=0;i<3;i++){
    colors[i].red=255-colors[i].red;
    colors[i].green=255-colors[i].green;
    colors[i].blue=255-colors[i].blue;
}
cout<<"Updated RGB values;\n";
for(int i=0;i<5;i++){
    cout<<"color"<<i+1<<":";
    cout<<"R="<<colors[i].red<<",";
    cout<<"G="<<colors[i].green<<",";
    cout<<"B="<<colors[i].blue<<endl;
}
return 0;
}
